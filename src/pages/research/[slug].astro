---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { href } from '../../lib/site';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={entry.data.title}
  description={`${entry.data.title} - research at the Biomedical Manufacturing and Design Lab.`}
>
  <PageHero title={entry.data.title} crumbs={[{ label: 'Research', path: '/research' }, { label: entry.data.title }]} />

  <section class="section">
    <div class="container">
      <article class="prose topic">
        <Content />
      </article>
      <p class="back">
        <a class="link-arrow" href={href('/research#past')}>
          <Icon name="arrow-left" /> All research topics
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .topic {
    max-width: 78ch;
    font-size: var(--step-0);
  }

  .topic :global(img) {
    padding: 1rem;
  }

  .back {
    max-width: 78ch;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
