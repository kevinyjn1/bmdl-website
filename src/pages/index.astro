---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import Marquee from '../components/Marquee.astro';
import Zoomable from '../components/Zoomable.astro';
import Carousel from '../components/Carousel.astro';
import NewsList from '../components/NewsList.astro';
import PressCards from '../components/PressCards.astro';
import Icon from '../components/Icon.astro';
import { image } from '../lib/images';
import { SITE, formatDate, href, plain, rich } from '../lib/site';
import home from '../data/home.json';
import news from '../data/news.json';
import press from '../data/press.json';
import people from '../data/people.json';
import research from '../data/research.json';
import journal from '../data/publications/journal.json';
import patents from '../data/publications/patents.json';

const [welcome, biomedical, semiconductor, education, training] = home.intro;
const groupPhoto = home.slides.find((s) => s.image.includes('group-winter-2025'))!;
const latest = news.items[0];
const latestLink = latest.html.match(/href="([^"]+)"/)?.[1];

const stats = [
  {
    value: journal.reduce((n, g) => n + g.items.length, 0),
    label: 'Journal papers',
    path: '/publications/journal-papers',
  },
  { value: patents.awarded.length, label: 'U.S. patents awarded', path: '/publications/patents' },
  { value: patents.licensed.length, label: 'Inventions licensed to industry', path: '/publications/patents' },
  { value: people.alumni.length, label: 'Lab alumni', path: '/people#alumni' },
];

const focusAreas = [
  { n: '01', title: 'Biomedical manufacturing', html: biomedical },
  { n: '02', title: 'Semiconductor manufacturing', html: semiconductor },
  { n: '03', title: 'Manufacturing education', html: education },
  { n: '04', title: 'Training future leaders', html: training },
];
---

<Base>
  <section class="hero blueprint on-dark" data-hero>
    <HeroScene />
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow intro" style="--i:0">
          University of Michigan &middot; Ann Arbor
        </p>
        <h1>
          <span class="line" style="--i:0">
            <span>Biomedical</span>
          </span>
          <span class="line" style="--i:1">
            <span class="hl">Manufacturing</span>
          </span>
          <span class="line" style="--i:2">
            <span>and Design Lab</span>
          </span>
        </h1>
        <p class="lead intro" style="--i:5">
          We strive to be the Leaders &amp; Best in manufacturing research and education by providing innovative and
          multidisciplinary solutions for our partners.
        </p>
        <div class="hero-actions intro" style="--i:6">
          <a class="btn btn--primary" href={href('/research')}>
            Explore our research <Icon name="arrow-right" />
          </a>
          <a class="btn btn--ghost" href={href('/people')}>
            Meet the team
          </a>
        </div>
        <a
          class="latest intro"
          style="--i:7"
          href={latestLink ?? href('/news')}
          target={latestLink ? '_blank' : undefined}
          rel={latestLink ? 'noopener noreferrer' : undefined}
        >
          <span class="latest-label mono">
            <span class="pulse"></span>Latest &middot; {formatDate(latest.date)}
          </span>
          <span class="latest-text">{plain(latest.html)}</span>
          <Icon name="arrow-up-right" size={18} />
        </a>
      </div>

      <div class="stage" data-hero-stage aria-hidden="true">
        <p class="hud hud-tl mono" data-hud-caption>
          <b>Fig. 01</b> Diamond grinding, particle view
        </p>
        <p class="hud hud-tr mono">
          <span class="dot"></span>Live
        </p>
        <p class="hud hud-bl mono hint">
          <span class="for-mouse">Hover the wheel to push the speed</span>
          <span class="for-touch">Tap the wheel to push the speed</span>
        </p>
        <p class="hud hud-br mono">
          <span>
            <b data-hud-count>0</b> diamond grains
          </span>
          <span>
            <b data-hud-speed>0</b> rpm
          </span>
        </p>
      </div>
    </div>

    <div class="container">
      <dl class="stats">
        {stats.map((stat) => (
          <a class="stat" href={href(stat.path)}>
            <dd data-count={stat.value}>{stat.value}</dd>
            <dt>{stat.label}</dt>
          </a>
        ))}
      </dl>
    </div>
  </section>

  <Marquee items={research.projects.map((p) => ({ label: p.short, path: `/research#${p.id}` }))} />

  <section class="section about">
    <div class="container about-grid">
      <div class="about-head" data-reveal>
        <p class="eyebrow">About the lab</p>
        <h2 class="h-section">Welcome to our lab</h2>
        <a class="link-arrow pi" href={href('/people/albert-shih')}>
          Led by Professor {SITE.pi.name}
          <Icon name="arrow-right" />
        </a>
        <figure class="frame photo" data-reveal="wipe">
          <Zoomable
            src={image(groupPhoto.image)}
            alt={groupPhoto.caption}
            widths={[640, 960, 1280]}
            sizes="(min-width: 960px) 440px, 92vw"
            width={1280}
          />
          <figcaption class="mono">{groupPhoto.caption}</figcaption>
        </figure>
      </div>
      <p class="welcome rich" data-reveal set:html={rich(welcome.replace(/^Welcome to our lab website!\s*/, ''))} />
    </div>

    <div class="container focus-list">
      {focusAreas.map((area) => (
        <article class="focus" data-reveal>
          <header>
            <span class="mono n" aria-hidden="true">
              {area.n}
            </span>
            <h3>{area.title}</h3>
          </header>
          <p class="rich" set:html={rich(area.html)} />
        </article>
      ))}
    </div>
  </section>

  <section class="section section--dark blueprint life">
    <div class="container section-head">
      <div data-reveal>
        <p class="eyebrow">Lab life</p>
        <h2 class="h-section">Moments from the lab</h2>
      </div>
      <p class="lead" data-reveal>
        Defenses, conferences, graduations, classes, and competition wins.
      </p>
    </div>
    <Carousel slides={home.slides} label="Lab photos" />
  </section>

  <section class="section news">
    <div class="container headlines">
      <div class="section-head">
        <div data-reveal>
          <p class="eyebrow">In the news</p>
          <h2 class="h-section">Making headlines</h2>
        </div>
        <a class="link-arrow" href={href('/news#press')} data-reveal>
          All coverage <Icon name="arrow-right" />
        </a>
      </div>
      <PressCards items={press.items.slice(0, 3)} source={press.source.label} />
    </div>

    <div class="container news-grid">
      <div class="news-head" data-reveal>
        <p class="eyebrow">Recent news</p>
        <h2 class="h-section">What's new at BMDL</h2>
        <a class="btn btn--outline" href={href('/news')}>
          More BMDL news <Icon name="arrow-right" />
        </a>
      </div>
      <NewsList items={news.items.slice(0, 9)} />
    </div>
  </section>

  <section class="section section--surface research">
    <div class="container section-head">
      <div data-reveal>
        <p class="eyebrow">Research</p>
        <h2 class="h-section">Current projects</h2>
      </div>
      <a class="link-arrow" href={href('/research')} data-reveal>
        All research topics <Icon name="arrow-right" />
      </a>
    </div>
    <div class="container project-grid">
      {research.projects.slice(0, 4).map((project, i) => (
        <a class="project" href={href(`/research#${project.id}`)} data-reveal style={`--reveal-i:${i}`}>
          <div class="project-img" data-spot>
            <Image src={image(project.image)} alt="" width={560} loading="lazy" />
          </div>
          <h3>{project.title}</h3>
          <span class="mono more">
            View project <Icon name="arrow-right" size={14} />
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--dark blueprint aurora cta">
    <div class="container cta-inner" data-reveal>
      <p class="eyebrow">Opportunities</p>
      <h2>Work with us</h2>
      <p class="lead">
        Every summer, we sponsor several undergraduate and medical school students as research assistants.
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary" href={href('/contact')}>
          Get in touch <Icon name="arrow-right" />
        </a>
        <a class="btn btn--ghost" href={href('/publications')}>
          Browse publications
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Count the hero statistics up from zero the first time they are seen.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduceMotion && counters.length) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = Number(el.dataset.count);
        const started = performance.now();
        const tick = (now: number) => {
          const progress = Math.min(1, (now - started) / 1400);
          el.textContent = String(Math.round(target * (1 - (1 - progress) ** 3)));
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    });
    counters.forEach((el) => observer.observe(el));
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(2rem, 5vw, 4rem));
    background:
      radial-gradient(ellipse 55% 70% at 88% 12%, rgba(42, 109, 179, 0.42), transparent 62%),
      radial-gradient(ellipse 40% 50% at 0% 100%, rgba(255, 203, 5, 0.07), transparent 70%),
      linear-gradient(180deg, var(--blue-950), var(--blue-900) 45%, var(--blue-800));
    color: var(--on-dark);
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  /* The headline is sized against its own column, so its longest line always fits. */
  .hero-copy {
    container-type: inline-size;
  }

  .hero h1 {
    margin-top: 1.4rem;
    font-size: min(var(--step-5), 13.6cqi);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  /* Each headline line rises out of its own mask. */
  .hero h1 .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .hero h1 .line > span {
    display: block;
  }

  .hl {
    color: var(--maize);
  }

  .hero .lead {
    margin-top: 1.75rem;
    max-width: 46ch;
    color: #c9d6e6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero h1 .line > span {
      animation: line-rise 1.1s var(--ease) both;
      animation-delay: calc(var(--i) * 120ms + 200ms);
    }

    .intro {
      animation: intro-fade 0.9s var(--ease) both;
      animation-delay: calc(var(--i) * 110ms + 150ms);
    }
  }

  @keyframes line-rise {
    from {
      transform: translateY(110%) rotate(4deg);
      transform-origin: left bottom;
    }
  }

  @keyframes intro-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Latest-news ticker */
  .latest {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem 0.9rem;
    max-width: 30rem;
    margin-top: 2.5rem;
    padding: 0.95rem 1.1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      transform 0.35s var(--ease),
      background 0.25s,
      border-color 0.25s;
  }

  .latest:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 203, 5, 0.55);
  }

  .latest-label {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--maize);
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--maize);
    box-shadow: 0 0 0 0 rgba(255, 203, 5, 0.6);
    animation: pulse 2.2s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 9px rgba(255, 203, 5, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 203, 5, 0);
    }
  }

  .latest-text {
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.45;
    color: #e6eef8;
  }

  .latest :global(svg) {
    align-self: end;
    color: var(--maize);
  }

  /* The stage the particle scene is centred on, with drawing-style annotations. */
  .stage {
    position: relative;
    container-type: inline-size;
    align-self: stretch;
    min-height: clamp(420px, 44vw, 600px);
  }

  .stage::before,
  .stage::after {
    content: '';
    position: absolute;
    width: 22px;
    height: 22px;
    border: 1.5px solid rgba(255, 203, 5, 0.75);
  }

  .stage::before {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }

  .stage::after {
    right: 0;
    bottom: 0;
    border-left: 0;
    border-top: 0;
  }

  .hud {
    position: absolute;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
    animation: intro-fade 1s var(--ease) 1.4s both;
  }

  .hud b {
    font-weight: 500;
    color: var(--maize);
    font-variant-numeric: tabular-nums;
  }

  .hud-tl {
    top: 0.9rem;
    left: 2.4rem;
  }

  .hud-tr {
    top: 0.9rem;
    right: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hud-tr .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ff5d5d;
    animation: blink 1.6s steps(2, start) infinite;
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  .hud-bl {
    left: 0.25rem;
    bottom: 0.9rem;
    transition: color 0.3s;
  }

  .hero:global(.is-boosting) .hud-bl {
    color: var(--maize);
  }

  .for-touch {
    display: none;
  }

  @media (hover: none) {
    .for-mouse {
      display: none;
    }

    .for-touch {
      display: inline;
    }
  }

  .hud-br {
    right: 2.4rem;
    bottom: 0.9rem;
    display: flex;
    gap: 1.25rem;
  }

  /* On a narrow stage the two bottom annotations no longer fit side by side: stack them. */
  @container (max-width: 560px) {
    .hud-bl {
      bottom: 2.4rem;
    }

    .hud-br {
      left: 0.25rem;
      right: auto;
    }
  }

  @container (max-width: 420px) {
    .hud-tl {
      max-width: 60%;
    }
  }

  .photo {
    margin: 2.25rem 0 0;
  }

  .photo :global(img) {
    width: 100%;
    aspect-ratio: 5 / 3.4;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .photo figcaption {
    margin-top: 0.8rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(3rem, 7vw, 5.5rem) 0 0;
    border-top: 1px solid var(--line-dark);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 1.5rem 2.25rem 0;
    transition: color 0.2s;
  }

  .stat + .stat {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line-dark);
  }

  .stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: #fff;
    transition: color 0.2s;
  }

  .stat:hover dd {
    color: var(--maize);
  }

  .stat dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  /* ---------- About ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .pi {
    margin-top: 1.5rem;
  }

  .welcome {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 450;
    line-height: 1.35;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  /* The four focus areas, set as a ruled list like the contents of a report: a large index
     number and title on the left, the text on the right, in the same columns as the welcome
     above it. */
  .focus-list {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .focus {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--line-strong);
  }

  /* A maize rule draws itself across the top of the row being read. */
  .focus::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--maize);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  .focus:hover::before {
    transform: scaleX(1);
  }

  .focus header {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .focus .n {
    flex: none;
    font-size: var(--step-2);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--maize-600);
  }

  .focus h3 {
    font-size: var(--step-2);
  }

  .focus p {
    color: var(--ink-2);
    line-height: 1.7;
  }

  /* ---------- News ---------- */
  .headlines {
    margin-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .news-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .news-head {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .news-head .btn {
    margin-top: 1.75rem;
  }

  /* ---------- Research teaser ---------- */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-img {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 0.3s,
      box-shadow 0.35s var(--ease);
  }

  .project-img :global(img) {
    max-height: 100%;
    width: auto;
    object-fit: contain;
    transition: transform 0.5s var(--ease);
  }

  .project:hover .project-img {
    border-color: var(--blue-500);
    box-shadow: var(--shadow-md);
  }

  .project:hover .project-img :global(img) {
    transform: scale(1.04);
  }

  .project h3 {
    font-size: 1.08rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--blue-600);
  }

  /* ---------- CTA ---------- */
  .cta {
    text-align: center;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta h2 {
    margin-top: 1rem;
    font-size: var(--step-4);
  }

  .cta .lead {
    margin-top: 1.25rem;
    max-width: 46ch;
  }

  .cta .hero-actions {
    justify-content: center;
  }

  @media (max-width: 960px) {
    .hero-grid,
    .about-grid,
    .news-grid,
    .focus {
      grid-template-columns: minmax(0, 1fr);
    }

    .stage {
      min-height: clamp(470px, 68vw, 560px);
    }

    .news-head {
      position: static;
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat + .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line-dark);
    }

    .welcome {
      font-size: var(--step-1);
      line-height: 1.5;
    }
  }
</style>
