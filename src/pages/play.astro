---
/**
 * The hidden page: Lumen Run, a small arcade game built on the lab's atherectomy research.
 * It is deliberately not in the navigation; see components/EasterEgg.astro for the ways in.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LumenRun from '../components/LumenRun.astro';
import { href } from '../lib/site';

const science = [
  {
    n: '01',
    title: 'Grinding calcified plaque',
    text: 'In atherectomy, a small burr spinning on a catheter grinds calcified plaque out of an artery. The lab models and measures how that burr moves, the force it grinds with, and how much material it removes.',
    link: { label: 'Atherectomy research', path: '/research#atherectomy' },
  },
  {
    n: '02',
    title: 'Heat is the limit',
    text: 'Grinding generates heat. The lab studies heat generation in atherectomy and heat accumulation in bone drilling, which is why the burr in the game has to back off and cool down.',
    link: { label: 'Bone drilling research', path: '/research#bone-drilling' },
  },
  {
    n: '03',
    title: 'Debris and clots',
    text: "The dust flying off the burr is a research topic too: the size of the debris in atherectomy. The clots drifting past are a nod to the lab's work on mechanical thrombectomy, the cutting of blood clots.",
    link: { label: 'Thrombectomy research', path: '/research#mechanical-thrombectomy' },
  },
];
---

<Base
  title="Lumen Run"
  description="A hidden arcade game from the Biomedical Manufacturing and Design Lab: grind calcified plaque out of an artery without overheating the burr or touching the vessel wall."
>
  <section class="play blueprint on-dark">
    <div class="container">
      <header class="intro">
        <p class="eyebrow">Hidden level</p>
        <h1>You found the lab arcade.</h1>
        <p class="lead">
          Lumen Run turns the lab's atherectomy research into a game: a spinning burr, an artery lined with calcified
          plaque, and heat to keep under control.
        </p>
      </header>

      <LumenRun />

      <p class="fineprint mono">A game, not a simulator: the speeds, sizes and scores are made up.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div data-reveal>
          <p class="eyebrow">Behind the game</p>
          <h2 class="h-section">Built on real research</h2>
        </div>
        <p class="lead" data-reveal>
          Every rule in Lumen Run comes from something the lab actually studies.
        </p>
      </div>

      <div class="science">
        {science.map((item, i) => (
          <article class="topic card" data-reveal data-spot style={`--reveal-i:${i}`}>
            <span class="mono n">{item.n}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="link-arrow" href={href(item.link.path)}>
              {item.link.label} <Icon name="arrow-right" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .play {
    background: linear-gradient(180deg, var(--blue-900), var(--blue-800));
    color: var(--on-dark);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 7vw, 5rem);
  }

  .intro {
    max-width: 44rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  h1 {
    margin-top: 1rem;
    font-size: var(--step-4);
    color: #fff;
  }

  .intro .lead {
    margin-top: 1.1rem;
    color: var(--on-dark-muted);
  }

  .fineprint {
    margin-top: 1.4rem;
    color: var(--on-dark-muted);
    text-transform: uppercase;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .science {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
  }

  .topic {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .n {
    color: var(--blue-600);
  }

  .topic h3 {
    font-size: var(--step-1);
  }

  .topic p {
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  .topic .link-arrow {
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }
</style>
