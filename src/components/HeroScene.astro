---
/**
 * Home page showpiece: an interactive 3D particle sketch of diamond grinding.
 *
 * A diamond grinding wheel made of a few thousand points assembles from scattered particles,
 * spins up, and throws glittering chips off a workpiece that ripples underneath it. The rim is
 * set with diamond grit: small faceted crystals that catch the light as the wheel turns.
 * Moving the pointer orbits the camera; hovering (or tapping) the wheel pushes the speed up.
 *
 * It is drawn from the lab's own work: nickel-bonded diamond wheels for grinding calcified
 * plaque inside arteries, diamond grinding and single-grain diamond scribing of silicon
 * carbide, and the particle-based (SPH / SPG) models the lab builds of those processes.
 *
 * Rendering is plain Canvas 2D with a hand-rolled perspective projection - no
 * dependencies. The loop pauses when the hero is off screen or the tab is hidden, and
 * visitors who prefer reduced motion get a single still frame.
 *
 * Expects to live inside an element marked [data-hero] that also contains a
 * [data-hero-stage] element: the scene is centred on that stage, and kept clear of the
 * stage's caption ([data-hud-caption]) if it has one.
 */
---

<canvas class="hero-scene" data-hero-scene aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-scene]');
  const host = canvas?.closest<HTMLElement>('[data-hero]');
  const stage = host?.querySelector<HTMLElement>('[data-hero-stage]');
  const ctx = canvas?.getContext('2d');

  if (canvas && host && stage && ctx) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const compact = window.innerWidth < 760;
    const TAU = Math.PI * 2;

    // ---- Geometry (world units: wheel radius = 1, wheel sits on the plane y = 0) ----
    const WHEEL_HALF_WIDTH = 0.17;
    const PLATE_X = 3.4;
    const PLATE_Z = 1.36;
    const IDLE_SPEED = 1.5; // rad/s
    const BOOST_SPEED = 6.5;

    // Deterministic pseudo-random numbers so the wheel looks the same on every visit.
    let seed = 20260;
    const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

    interface Scatter {
      ox: number;
      oy: number;
      oz: number;
      delay: number;
    }
    interface WheelPoint extends Scatter {
      r: number;
      a: number;
      z: number;
      size: number;
    }
    interface PlatePoint extends Scatter {
      x: number;
      z: number;
      d: number;
    }
    /** One grain of diamond grit: an octahedral crystal, seen as a rhombus with four facets. */
    interface Diamond extends Scatter {
      r: number;
      a: number;
      z: number;
      /** Half the long diagonal, in pixels at the focal distance. */
      half: number;
      /** Short diagonal over long diagonal. */
      aspect: number;
      /** Angle of the long diagonal from the wheel's radius. */
      tilt: number;
      /** Where in its turn this crystal flashes. */
      glint: number;
      /** Large enough to draw facet by facet; the rest are fine grit. */
      faceted: boolean;
      /** Synthetic diamond grit is yellow as often as it is clear. */
      maize: boolean;
    }

    const scatter = (delay: number): Scatter => ({
      ox: (rand() - 0.5) * 10,
      oy: (rand() - 0.5) * 7,
      oz: (rand() - 0.5) * 10,
      delay,
    });

    // Diamond grit on the rim: a single layer of crystals, a few large ones among fine grit.
    const diamonds: Diamond[] = [];
    for (let i = 0, n = compact ? 520 : 960; i < n; i++) {
      const faceted = rand() < 0.15;
      diamonds.push({
        r: 1 + (rand() - 0.5) * (faceted ? 0.012 : 0.03),
        a: rand() * TAU,
        z: (rand() * 2 - 1) * WHEEL_HALF_WIDTH,
        half: faceted ? 3.8 + rand() * 3.2 : 1.1 + rand() * 1.2,
        aspect: 0.52 + rand() * 0.26,
        tilt: (rand() - 0.5) * 1.5,
        glint: rand() * TAU,
        faceted,
        maize: rand() < 0.3,
        ...scatter(0.35 + rand() * 0.9),
      });
    }
    // Clear crystals first, yellow ones after, so the fill colour changes once per frame.
    diamonds.sort((p, q) => Number(p.maize) - Number(q.maize));

    // Structure: crisp rim edges, concentric rings, flange and bore on both faces.
    const edges: WheelPoint[] = [];
    const rings: WheelPoint[] = [];
    for (const z of [-WHEEL_HALF_WIDTH, WHEEL_HALF_WIDTH]) {
      const ring = (list: WheelPoint[], r: number, count: number, size: number) => {
        for (let i = 0; i < count; i++) {
          list.push({ r, a: (i / count) * TAU, z, size, ...scatter(r * 0.5 + rand() * 0.5) });
        }
      };
      ring(edges, 1, compact ? 120 : 190, 1.4);
      ring(edges, 0.2, 44, 1.5);
      ring(edges, 0.09, 22, 1.3);
      for (const r of [0.36, 0.52, 0.68, 0.84]) ring(rings, r, Math.round((TAU * r) / (compact ? 0.075 : 0.052)), 1.1);
      for (let bolt = 0; bolt < 6; bolt++) {
        for (let k = 0; k < 5; k++) {
          edges.push({
            r: 0.275 + (rand() - 0.5) * 0.02,
            a: (bolt / 6) * TAU + (rand() - 0.5) * 0.07,
            z,
            size: 1.7,
            ...scatter(0.2 + rand() * 0.4),
          });
        }
      }
    }

    // The workpiece: a plate of lattice points under the wheel.
    const plate: PlatePoint[] = [];
    const step = compact ? 0.21 : 0.16;
    for (let x = -PLATE_X; x <= PLATE_X + 0.001; x += step) {
      for (let z = -PLATE_Z; z <= PLATE_Z + 0.001; z += step) {
        plate.push({ x, z, d: Math.hypot(x, z * 1.25), ...scatter(rand() * 0.8) });
      }
    }

    // Chips thrown from the cut: x, y, z, vx, vy, vz, life, maxLife, spin, spin rate, size.
    // A negative size marks a yellow chip.
    const CHIP_STRIDE = 11;
    const CHIP_COUNT = compact ? 170 : 340;
    const chips = new Float32Array(CHIP_COUNT * CHIP_STRIDE);
    let chipCursor = 0;
    let chipDebt = 0;

    const ICE = '#dcefff';
    const MAIZE = '#ffd75e';
    // The angle, in the plane of the wheel, the light falls from.
    const LIGHT_ANGLE = 2.2;
    // Flashes to draw on top of the grit this frame: x, y, reach, strength.
    const flashes: number[] = [];

    // ---- Camera & simulation state ----
    const REST_YAW = -0.52;
    const REST_PITCH = 0.3;
    let yaw = REST_YAW;
    let pitch = REST_PITCH;
    let yawTarget = REST_YAW;
    let pitchTarget = REST_PITCH;
    let phi = 0;
    let omega = 0;
    let boost = false;
    let boostUntil = 0;

    let width = 0;
    let height = 0;
    let originX = 0;
    let originY = 0;
    let unit = 100; // pixels per world unit at the focal distance
    let grit = 1; // crystal size relative to the wheel, so small screens are not crowded
    const CAMERA_DISTANCE = 7;
    const RING = 1.34; // outer radius of the gauge ring drawn around the wheel
    const SEAT = 0.92; // how far below the middle of the stage the wheel touches down, in wheel radii
    // How far above that point the top of the gauge ring is drawn with the camera at rest.
    const RING_REACH =
      ((1 + RING) * Math.cos(REST_PITCH) * CAMERA_DISTANCE) / (CAMERA_DISTANCE - (1 + RING) * Math.sin(REST_PITCH));

    let cosY = 1;
    let sinY = 0;
    let cosP = 1;
    let sinP = 0;
    let sx = 0;
    let sy = 0;
    let ss = 1; // projected x, y and scale of the last projected point

    const project = (x: number, y: number, z: number) => {
      const x1 = x * cosY + z * sinY;
      const z1 = -x * sinY + z * cosY;
      const y2 = y * cosP - z1 * sinP;
      const z2 = y * sinP + z1 * cosP;
      ss = CAMERA_DISTANCE / Math.max(0.6, CAMERA_DISTANCE - z2);
      sx = originX + x1 * unit * ss;
      sy = originY - y2 * unit * ss;
    };

    const layout = () => {
      const hostRect = host.getBoundingClientRect();
      const stageRect = stage.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = hostRect.width;
      height = hostRect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // As large as the stage allows, while the gauge ring stays clear of the caption along the top.
      const clear = caption ? caption.offsetTop + caption.offsetHeight + 12 : 44;
      unit = Math.min(
        Math.min(stageRect.width, stageRect.height) * (compact ? 0.3 : 0.31),
        (stageRect.height / 2 - clear) / (RING_REACH - SEAT),
      );
      grit = Math.min(1.2, Math.max(0.72, unit / 170));
      originX = stageRect.left - hostRect.left + stageRect.width * (compact ? 0.44 : 0.46);
      originY = stageRect.top - hostRect.top + stageRect.height / 2 + unit * SEAT;
    };

    const easeOut = (p: number) => 1 - (1 - p) ** 3;
    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);

    const caption = stage.querySelector<HTMLElement>('[data-hud-caption]');
    const hudSpeed = host.querySelector<HTMLElement>('[data-hud-speed]');
    const hudCount = host.querySelector<HTMLElement>('[data-hud-count]');
    if (hudCount) hudCount.textContent = diamonds.length.toLocaleString('en-US');
    let hudTick = 0;

    const spawnChip = () => {
      const i = chipCursor * CHIP_STRIDE;
      chipCursor = (chipCursor + 1) % CHIP_COUNT;
      const speed = omega * (1 + rand() * 0.95) * 1.1;
      const lift = rand() ** 2 * 0.62;
      const life = 0.45 + rand() * 0.95;
      const size = 1.1 + rand() ** 2.4 * 3.3;
      chips[i] = (rand() - 0.5) * 0.05;
      chips[i + 1] = 0.012;
      chips[i + 2] = (rand() * 2 - 1) * WHEEL_HALF_WIDTH;
      chips[i + 3] = speed * Math.cos(lift);
      chips[i + 4] = speed * Math.sin(lift) + 0.25;
      chips[i + 5] = (rand() - 0.5) * 0.95;
      chips[i + 6] = life;
      chips[i + 7] = life;
      chips[i + 8] = rand() * TAU;
      chips[i + 9] = (rand() < 0.5 ? -1 : 1) * (7 + rand() * 16);
      chips[i + 10] = rand() < 0.3 ? -size : size;
    };

    /** Fill the triangle between the point (cx, cy) and two corners given relative to it. */
    const facet = (cx: number, cy: number, ux: number, uy: number, vx: number, vy: number) => {
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + ux, cy + uy);
      ctx.lineTo(cx + vx, cy + vy);
      ctx.fill();
    };

    /** Fill the rhombus around (cx, cy) with half diagonals (lx, ly) and (wx, wy). */
    const rhombus = (cx: number, cy: number, lx: number, ly: number, wx: number, wy: number) => {
      ctx.beginPath();
      ctx.moveTo(cx + lx, cy + ly);
      ctx.lineTo(cx + wx, cy + wy);
      ctx.lineTo(cx - lx, cy - ly);
      ctx.lineTo(cx - wx, cy - wy);
      ctx.fill();
    };

    let start = 0;
    let last = 0;

    const draw = (time: number, still = false) => {
      if (!start) start = last = time;
      const t = still ? 60 : (time - start) / 1000;
      const dt = still ? 0 : Math.min(0.05, (time - last) / 1000);
      last = time;

      // The wheel spins up once it has assembled.
      const spinUp = still ? 0 : clamp01((t - 1.5) / 1.8);
      if (boost && time > boostUntil && boostUntil) boost = false;
      omega += ((boost ? BOOST_SPEED : IDLE_SPEED) * spinUp - omega) * Math.min(1, dt * 2.4);
      phi += omega * dt;
      yaw += (yawTarget - yaw) * Math.min(1, dt * 3.5);
      pitch += (pitchTarget - pitch) * Math.min(1, dt * 3.5);
      cosY = Math.cos(yaw);
      sinY = Math.sin(yaw);
      cosP = Math.cos(pitch);
      sinP = Math.sin(pitch);
      const heat = Math.min(1, omega / IDLE_SPEED);

      ctx.clearRect(0, 0, width, height);
      ctx.globalCompositeOperation = 'lighter';

      // Soft glow behind the wheel.
      project(0, 1, 0);
      const halo = ctx.createRadialGradient(sx, sy, 0, sx, sy, unit * 1.9);
      halo.addColorStop(0, 'rgba(42, 109, 179, 0.26)');
      halo.addColorStop(1, 'rgba(42, 109, 179, 0)');
      ctx.globalAlpha = 1;
      ctx.fillStyle = halo;
      ctx.fillRect(sx - unit * 1.9, sy - unit * 1.9, unit * 3.8, unit * 3.8);

      // Workpiece: ripples travel outward from the contact point.
      for (const p of plate) {
        const k = easeOut(clamp01((t - p.delay) / 1.4));
        if (k <= 0) continue;
        const away = 1 - k;
        const ripple = 0.04 * Math.sin(p.d * 7 - t * (2 + omega * 1.3)) * Math.exp(-p.d * 0.85) * heat;
        project(p.x + p.ox * away, ripple + p.oy * away, p.z + p.oz * away);
        const glow = Math.exp(-p.d * 1.35) * heat;
        const size = (1.3 + glow * 1.6) * ss;
        ctx.globalAlpha = k * (0.34 + glow * 0.66);
        ctx.fillStyle = glow > 0.18 ? '#ffcb05' : '#9fbfe6';
        ctx.fillRect(sx - size / 2, sy - size / 2, size, size);
      }

      // A fixed protractor ring around the wheel, like a gauge on a drawing.
      ctx.globalAlpha = 0.2 * easeOut(clamp01((t - 1) / 1.2));
      ctx.strokeStyle = '#9fbfe6';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i < 72; i++) {
        const a = (i / 72) * TAU - t * 0.04;
        const outer = i % 6 === 0 ? RING : 1.27;
        project(1.2 * Math.cos(a), 1 + 1.2 * Math.sin(a), 0);
        ctx.moveTo(sx, sy);
        project(outer * Math.cos(a), 1 + outer * Math.sin(a), 0);
        ctx.lineTo(sx, sy);
      }
      ctx.stroke();

      // The body of the wheel, drawn faintly so the particles stay in charge: two glassy faces,
      // and between them the band that holds the grit, lit from the same side as the crystals.
      const light = LIGHT_ANGLE + (yaw - REST_YAW) * 4 + (pitch - REST_PITCH) * 4;
      const built = easeOut(clamp01((t - 1.2) / 1.6));
      if (built > 0) {
        const SEGMENTS = 72;
        ctx.fillStyle = '#6fa6e6';
        ctx.globalAlpha = built * 0.055;
        for (const z of [-WHEEL_HALF_WIDTH, WHEEL_HALF_WIDTH]) {
          ctx.beginPath();
          for (let i = 0; i <= SEGMENTS; i++) {
            const a = (i / SEGMENTS) * TAU;
            project(0.985 * Math.cos(a), 1 + 0.985 * Math.sin(a), z);
            if (i) ctx.lineTo(sx, sy);
            else ctx.moveTo(sx, sy);
          }
          // The bore, traced the other way round so it is left open.
          for (let i = SEGMENTS; i >= 0; i--) {
            const a = (i / SEGMENTS) * TAU;
            project(0.2 * Math.cos(a), 1 + 0.2 * Math.sin(a), z);
            ctx.lineTo(sx, sy);
          }
          ctx.fill();
        }
        ctx.fillStyle = '#b9d6f7';
        for (let i = 0; i < SEGMENTS; i++) {
          const a = (i / SEGMENTS) * TAU;
          const b = ((i + 1) / SEGMENTS) * TAU;
          const lit = Math.max(0, Math.cos((a + b) / 2 - light));
          ctx.globalAlpha = built * (0.03 + 0.13 * lit ** 3);
          ctx.beginPath();
          project(Math.cos(a), 1 + Math.sin(a), -WHEEL_HALF_WIDTH);
          ctx.moveTo(sx, sy);
          project(Math.cos(b), 1 + Math.sin(b), -WHEEL_HALF_WIDTH);
          ctx.lineTo(sx, sy);
          project(Math.cos(b), 1 + Math.sin(b), WHEEL_HALF_WIDTH);
          ctx.lineTo(sx, sy);
          project(Math.cos(a), 1 + Math.sin(a), WHEEL_HALF_WIDTH);
          ctx.lineTo(sx, sy);
          ctx.fill();
        }
      }

      // Wheel structure.
      const drawPoints = (points: WheelPoint[], color: string, alpha: number) => {
        ctx.fillStyle = color;
        for (const p of points) {
          const k = easeOut(clamp01((t - p.delay) / 1.5));
          if (k <= 0) continue;
          const away = 1 - k;
          const a = p.a + phi;
          project(p.r * Math.cos(a) + p.ox * away, 1 + p.r * Math.sin(a) + p.oy * away, p.z + p.oz * away);
          const size = p.size * ss;
          ctx.globalAlpha = k * alpha * (0.55 + (ss - 0.86) * 1.6);
          ctx.fillRect(sx - size / 2, sy - size / 2, size, size);
        }
      };
      drawPoints(rings, '#7fa9dd', 0.62);
      drawPoints(edges, '#e8f1fb', 0.85);

      // Diamond grit. Each crystal is a rhombus lying in the plane of the wheel. Its facets are
      // shaded by how squarely they face the light, so they brighten in turn as the wheel
      // rotates, and every crystal flashes once per revolution. Orbiting the camera moves the
      // light across them.
      // Once the wheel is pushed, the grit smears into streaks along its path.
      const blur = Math.min(0.07, Math.max(0, omega - 2.4) * 0.016);
      // Where one step along the wheel's own x and y axes lands on screen, before perspective.
      const xx = cosY;
      const xy = -sinY * sinP;
      const yy = -cosP;
      flashes.length = 0;
      ctx.lineCap = 'round';
      ctx.fillStyle = ctx.strokeStyle = ICE;
      let maize = false;
      for (const p of diamonds) {
        const k = easeOut(clamp01((t - p.delay) / 1.5));
        if (k <= 0) continue;
        if (p.maize !== maize) {
          maize = p.maize;
          ctx.fillStyle = ctx.strokeStyle = maize ? MAIZE : ICE;
        }
        const away = 1 - k;
        const a = p.a + phi;
        project(p.r * Math.cos(a) + p.ox * away, 1 + p.r * Math.sin(a) + p.oy * away, p.z + p.oz * away);
        const cx = sx;
        const cy = sy;
        const half = p.half * grit * ss;
        // Nearer crystals are brighter.
        const base = k * clamp01(0.42 + (ss - 0.86) * 2.2);
        const sparkle = Math.cos(a + p.glint - light);

        if (blur > 0) {
          project(p.r * Math.cos(a - blur), 1 + p.r * Math.sin(a - blur), p.z);
          ctx.globalAlpha = base * (p.faceted ? 0.2 : 0.42);
          ctx.lineWidth = half * (p.faceted ? 0.8 : 1.1);
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(sx, sy);
          ctx.stroke();
          if (!p.faceted) continue;
        }

        // The crystal's half diagonals on screen: the long one, then the short one.
        const turn = a + p.tilt;
        const c = Math.cos(turn);
        const s = Math.sin(turn);
        const lx = c * xx * half;
        const ly = (c * xy + s * yy) * half;
        const wx = -s * xx * half * p.aspect;
        const wy = (c * yy - s * xy) * half * p.aspect;

        if (!p.faceted) {
          ctx.globalAlpha = base * (0.34 + 0.66 * (0.5 + 0.5 * sparkle) ** 3);
          rhombus(cx, cy, lx, ly, wx, wy);
          continue;
        }

        // The whole crystal dimly, then the two facets that are turned towards the light.
        const flash = sparkle > 0.94 ? ((sparkle - 0.94) / 0.06) ** 2 : 0;
        ctx.globalAlpha = base * 0.3;
        rhombus(cx, cy, lx, ly, wx, wy);
        const facing = turn + Math.PI / 4 - light;
        const cf = Math.cos(facing);
        const sf = Math.sin(facing);
        ctx.globalAlpha = clamp01(base * (0.72 + flash) * Math.abs(cf));
        if (cf > 0) facet(cx, cy, lx, ly, wx, wy);
        else facet(cx, cy, -lx, -ly, -wx, -wy);
        ctx.globalAlpha = clamp01(base * (0.72 + flash) * Math.abs(sf));
        if (sf > 0) facet(cx, cy, -wx, -wy, lx, ly);
        else facet(cx, cy, wx, wy, -lx, -ly);
        if (flash > 0.04) flashes.push(cx, cy, half * (1.3 + 2.7 * flash), flash * base);
      }

      // Chips thrown from the cut: tumbling crystals, each trailing a short streak.
      if (!still) {
        chipDebt += omega * (boost ? 46 : 38) * dt * (compact ? 0.6 : 1);
        while (chipDebt >= 1) {
          chipDebt -= 1;
          if (omega > 0.5) spawnChip();
        }
      }
      for (let i = 0; i < chips.length; i += CHIP_STRIDE) {
        let life = chips[i + 6];
        if (life <= 0) continue;
        life -= dt;
        chips[i + 6] = life;
        let y = chips[i + 1];
        let vy = chips[i + 4] - 5.6 * dt;
        const x = chips[i] + chips[i + 3] * dt;
        const z = chips[i + 2] + chips[i + 5] * dt;
        y += vy * dt;
        if (y < 0 && x < PLATE_X && Math.abs(z) < PLATE_Z) {
          y = 0;
          vy *= -0.36;
          chips[i + 3] *= 0.72;
        }
        const spin = chips[i + 8] + chips[i + 9] * dt;
        chips[i] = x;
        chips[i + 1] = y;
        chips[i + 2] = z;
        chips[i + 4] = vy;
        chips[i + 8] = spin;

        const age = life / chips[i + 7];
        const fade = Math.min(1, age * 1.8);
        const size = Math.abs(chips[i + 10]);
        project(x, y, z);
        const x1 = sx;
        const y1 = sy;
        const half = size * grit * ss * 1.15;
        project(x - chips[i + 3] * 0.03, y - vy * 0.03, z - chips[i + 5] * 0.03);
        // White hot as it leaves the cut, then its own colour.
        ctx.fillStyle = ctx.strokeStyle = age > 0.8 ? '#ffffff' : chips[i + 10] < 0 ? MAIZE : ICE;
        ctx.globalAlpha = fade * 0.4;
        ctx.lineWidth = Math.max(1, half * 0.5);
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(sx, sy);
        ctx.stroke();

        // Tumbling turns the crystal edge-on and face-on in turn; it flashes as it faces us.
        const face = Math.abs(Math.cos(spin * 0.6 + i));
        const c = Math.cos(spin);
        const s = Math.sin(spin);
        const wide = half * (0.2 + 0.5 * face);
        ctx.globalAlpha = fade * (0.4 + 0.6 * face ** 3);
        rhombus(x1, y1, c * half, s * half, -s * wide, c * wide);
        if (size > 2.4 && face > 0.9) flashes.push(x1, y1, half * (1 + 14 * (face - 0.9)), fade * (face - 0.9) * 10);
      }

      // Flashes: a four-pointed star where a crystal catches the light, its two arms split
      // slightly warm and cool, as diamond splits white light.
      for (let i = 0; i < flashes.length; i += 4) {
        const x = flashes[i];
        const y = flashes[i + 1];
        const reach = flashes[i + 2];
        ctx.globalAlpha = clamp01(flashes[i + 3]);
        ctx.fillStyle = '#fff1bf';
        rhombus(x, y, reach, 0, 0, 0.9);
        ctx.fillStyle = '#cfeaff';
        rhombus(x, y, 0, reach, 0.9, 0);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(x - 1, y - 1, 2, 2);
      }

      // Flare at the contact point.
      if (heat > 0.05) {
        project(0, 0.02, 0);
        const flicker = 0.75 + 0.25 * Math.sin(t * 37) * Math.sin(t * 23);
        const radius = unit * (0.2 + omega * 0.035) * flicker;
        const flare = ctx.createRadialGradient(sx, sy, 0, sx, sy, radius);
        flare.addColorStop(0, 'rgba(255, 246, 214, 0.95)');
        flare.addColorStop(0.25, 'rgba(255, 203, 5, 0.55)');
        flare.addColorStop(1, 'rgba(255, 138, 31, 0)');
        ctx.globalAlpha = heat;
        ctx.fillStyle = flare;
        ctx.fillRect(sx - radius, sy - radius, radius * 2, radius * 2);
      }
      ctx.globalAlpha = 1;

      if (hudSpeed && time - hudTick > 120) {
        hudTick = time;
        hudSpeed.textContent = Math.round(omega * 800).toLocaleString('en-US');
      }
    };

    // ---- Run loop ----
    let frame = 0;
    let visible = true;
    const loop = (time: number) => {
      draw(time);
      frame = visible && !document.hidden ? requestAnimationFrame(loop) : 0;
    };
    const resume = () => {
      if (frame || reduceMotion || !visible || document.hidden) return;
      last = performance.now();
      frame = requestAnimationFrame(loop);
    };

    layout();
    if (reduceMotion) draw(0, true);
    else resume();

    new ResizeObserver(() => {
      layout();
      if (reduceMotion) draw(0, true);
    }).observe(host);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      resume();
    }).observe(host);
    document.addEventListener('visibilitychange', resume);

    // The scene sinks slightly as the page scrolls, so the hero has depth against the content.
    // Only where the stage sits beside the headline: once it is stacked below, it is reached by
    // scrolling, and the wheel has to stay inside its frame.
    if (!reduceMotion) {
      const stacked = window.matchMedia('(max-width: 960px)');
      const sink = () => {
        const depth = stacked.matches ? 0 : window.scrollY * 0.16;
        canvas.style.transform = depth ? `translate3d(0, ${depth.toFixed(1)}px, 0)` : '';
      };
      window.addEventListener('scroll', () => visible && sink(), { passive: true });
      stacked.addEventListener('change', sink);
    }

    // ---- Interaction ----
    host.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      const rect = host.getBoundingClientRect();
      const nx = (event.clientX - rect.left) / rect.width - 0.5;
      const ny = (event.clientY - rect.top) / rect.height - 0.5;
      yawTarget = REST_YAW + nx * 0.42;
      pitchTarget = REST_PITCH + ny * 0.2;
      const stageRect = stage.getBoundingClientRect();
      boostUntil = 0;
      boost =
        event.clientX > stageRect.left &&
        event.clientX < stageRect.right &&
        event.clientY > stageRect.top &&
        event.clientY < stageRect.bottom;
      host.classList.toggle('is-boosting', boost);
    });
    host.addEventListener('pointerleave', () => {
      yawTarget = REST_YAW;
      pitchTarget = REST_PITCH;
      boost = false;
      host.classList.remove('is-boosting');
    });
    // Touch: a tap on the stage spins the wheel up for a few seconds.
    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch') return;
      boost = true;
      boostUntil = performance.now() + 2600;
    });
  }
</script>

<style>
  .hero-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    /* Keep the headline side calm: the scene fades out toward the left edge. */
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.28) 34%, #000 58%);
  }

  @media (max-width: 960px) {
    .hero-scene {
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.14) 0%, rgba(0, 0, 0, 0.3) 42%, #000 62%);
    }
  }
</style>
