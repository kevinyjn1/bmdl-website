---
/** Portrait card for a lab member. Links to an internal profile page or an external page when available. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { image } from '../lib/images';
import { href, initials } from '../lib/site';

interface Props {
  name: string;
  image: string | null;
  profile: string | null;
  link: string | null;
  year?: number;
  /** Further links for this person, listed under the card. */
  links?: { label: string; href: string }[];
  size?: 'md' | 'sm';
}

const { name, image: photo, profile, link, year, links = [], size = 'md' } = Astro.props;
const url = profile ? href(`/people/${profile}`) : link;
const external = !profile && !!link;
const Tag = url ? 'a' : 'div';
const px = size === 'md' ? 480 : 320;
---

<Tag
  class:list={['person', size, { linked: !!url }]}
  href={url}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-year={year}
>
  <div class="portrait">
    {photo ? (
      <Image src={image(photo)} alt={`Portrait of ${name}`} width={px} loading="lazy" />
    ) : (
      <span class="initials" aria-hidden="true">
        {initials(name)}
      </span>
    )}
    {year && <span class="year mono">{year}</span>}
  </div>
  <p class="name">
    {name}
    {url && <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={14} />}
  </p>
</Tag>
{links.map((extra) => (
  <a class="extra mono" href={extra.href} target="_blank" rel="noopener noreferrer">
    {extra.label} <Icon name="arrow-up-right" size={12} />
  </a>
))}

<style>
  .person {
    display: block;
  }

  .extra {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.25rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s;
  }

  .extra:hover {
    color: var(--blue-700);
  }

  .portrait {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: linear-gradient(135deg, var(--blue-700), var(--blue-900));
    border: 1px solid var(--line);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    transition: transform 0.6s var(--ease);
  }

  .linked:hover .portrait :global(img) {
    transform: scale(1.05);
  }

  .initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.85);
  }

  .sm .initials {
    font-size: 1.8rem;
  }

  .year {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 16, 31, 0.78);
    color: var(--maize);
    font-size: 0.68rem;
    backdrop-filter: blur(6px);
  }

  .name {
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .sm .name {
    margin-top: 0.6rem;
    font-size: 0.95rem;
  }

  .name :global(svg) {
    display: inline-block;
    vertical-align: -0.1em;
    margin-left: 0.15rem;
    color: var(--blue-500);
    opacity: 0.55;
    transition:
      transform 0.25s var(--ease),
      opacity 0.2s;
  }

  .linked:hover .name {
    color: var(--blue-600);
  }

  .linked:hover .name :global(svg) {
    opacity: 1;
    transform: translate(2px, 0);
  }
</style>
