---
/**
 * Lumen Run, the lab's hidden arcade game: the playfield with its HUD and its title, pause and
 * results cards. The game itself (rules, drawing, input) lives in src/game/.
 */
import Icon from './Icon.astro';
import { MAX_INTEGRITY } from '../game/sim.ts';
import { LEADERBOARD_URL, href } from '../lib/site';
---

<div class="lumen-run" data-lumen-run data-leaderboard={LEADERBOARD_URL}>
  <div class="stage frame" data-lr="stage" data-mode="demo" tabindex="-1" role="group" aria-label="Lumen Run, a game">
    <canvas data-lr="canvas" aria-hidden="true"></canvas>

    <div class="hud" aria-hidden="true">
      <div class="hud-score">
        <span class="k">Score</span>
        <span class="v">
          <b data-lr="score">0</b>
          <span class="multiplier" data-lr="multiplier">
            &times;1
          </span>
        </span>
      </div>
      <div class="hud-heat" data-lr="heat-box">
        <span class="k">Burr heat</span>
        <span class="bar">
          <i></i>
        </span>
      </div>
      <div class="hud-vessel">
        <span class="k">Vessel</span>
        <span class="pips" data-lr="pips">
          {Array.from({ length: MAX_INTEGRITY }, () => (
            <i />
          ))}
        </span>
      </div>
      <p class="hud-distance">
        <b data-lr="distance">0</b> mm
      </p>
      <p class="hud-chase" data-lr="chase" hidden>
        <span class="k" data-lr="chase-label">
          Next to beat
        </span>
        <span class="chase-line">
          <b data-lr="chase-name"></b>
          <span data-lr="chase-score"></span>
        </span>
      </p>
    </div>

    <p class="banner" data-lr="banner" aria-hidden="true">
      <b></b>
      <span></span>
    </p>

    <button class="pause" type="button" data-lr="pause" aria-label="Pause the game">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"></rect>
        <rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"></rect>
      </svg>
    </button>

    <div class="panel start" data-lr="start-card">
      <div class="panel-body">
        <p class="eyebrow">BMDL arcade</p>
        <h2 class="title">
          Lumen <em>Run</em>
        </h2>
        <p class="pitch">Steer the burr. Grind the plaque. Spare the vessel.</p>
        <ul class="rules">
          <li>
            <span class="swatch swatch-plaque"></span>
            Grind plaque for points
          </li>
          <li>
            <span class="swatch swatch-wall"></span>
            Never touch the vessel wall
          </li>
          <li>
            <span class="swatch swatch-heat"></span>
            Back off before the burr overheats
          </li>
        </ul>
        <button class="btn btn--primary" type="button" data-lr="start">
          Start <Icon name="arrow-right" />
        </button>
        <noscript>
          <p class="noscript">Lumen Run needs JavaScript to run.</p>
        </noscript>
        <p class="hint mono">
          <span class="for-mouse">Steer with the mouse or the arrow keys &middot; P pauses</span>
          <span class="for-touch">Drag anywhere to steer</span>
          <span class="best" data-lr="start-best" hidden>
            Best <b></b>
          </span>
        </p>
      </div>
      <aside class="top" data-lr="top-card" aria-label="Top scores" hidden>
        <p class="top-label mono">Leaderboard</p>
        <h3>Top scores</h3>
        <ol class="top-rows" data-lr="top-rows"></ol>
        <p class="top-note" data-lr="top-note"></p>
        <a class="top-more mono" href="#leaderboard">
          Full leaderboard <Icon name="arrow-right" size={12} />
        </a>
      </aside>
    </div>

    <div class="panel" data-lr="paused-card" hidden>
      <div class="panel-body">
        <p class="eyebrow">Paused</p>
        <h2 class="title title-small">Burr on standby</h2>
        <button class="btn btn--primary" type="button" data-lr="resume">
          Resume <Icon name="arrow-right" />
        </button>
      </div>
    </div>

    <div class="panel" data-lr="over-card" hidden>
      <div class="panel-body" data-lr="over-result">
        <p class="eyebrow" data-lr="cause">
          Run complete
        </p>
        <p class="final">
          <b data-lr="final-score">0</b>
          <span class="new-best mono" data-lr="new-best" hidden>
            New best
          </span>
        </p>
        <p class="rank">
          Level <b data-lr="rank"></b>
        </p>
        <p class="would mono" data-lr="would-rank" hidden></p>
        <dl class="stats mono">
          <div>
            <dt>Cleared</dt>
            <dd data-lr="stat-cleared"></dd>
          </div>
          <div>
            <dt>Distance</dt>
            <dd data-lr="stat-distance"></dd>
          </div>
          <div>
            <dt>Sweeps</dt>
            <dd data-lr="stat-sweeps"></dd>
          </div>
          <div>
            <dt>Clots</dt>
            <dd data-lr="stat-clots"></dd>
          </div>
        </dl>
        <div class="actions">
          <button class="btn btn--primary" type="button" data-lr="again">
            Play again <Icon name="arrow-right" />
          </button>
          <button class="btn btn--ghost" type="button" data-lr="open-post" hidden>
            Post your score
          </button>
        </div>
        <a class="research" href={href('/research#atherectomy')}>
          See the real research <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <form class="panel-body post" data-lr="post-form" novalidate hidden>
        <p class="eyebrow">Leaderboard</p>
        <h2 class="title title-post">
          Post <span data-lr="post-score">0</span> points
        </h2>
        <div class="fields">
          <label class="field">
            <span class="mono">Name</span>
            <input data-lr="post-name" name="name" type="text" autocomplete="nickname" maxlength="20" required />
          </label>
          <label class="field">
            <span class="mono">
              Email <i>optional</i>
            </span>
            <input data-lr="post-email" name="email" type="email" autocomplete="email" maxlength="254" />
          </label>
        </div>
        <p class="privacy">
          Your name appears on the public leaderboard. Your email is stored privately by the lab and never shown.
        </p>
        <p class="form-error" data-lr="post-error" role="alert"></p>
        <div class="actions">
          <button class="btn btn--primary" type="submit" data-lr="post-submit">
            Post score
          </button>
          <button class="btn btn--ghost" type="button" data-lr="post-back">
            Back
          </button>
        </div>
      </form>

      <div class="panel-body" data-lr="posted" hidden>
        <p class="eyebrow">Score posted</p>
        <p class="final">
          <b data-lr="posted-rank">#1</b>
        </p>
        <p class="rank" data-lr="posted-detail"></p>
        <div class="actions posted-actions">
          <button class="btn btn--primary" type="button" data-lr="again-posted">
            Play again <Icon name="arrow-right" />
          </button>
          <a class="btn btn--ghost" href="#leaderboard">
            See the leaderboard
          </a>
        </div>
      </div>
    </div>

    <p class="visually-hidden" role="status" data-lr="status"></p>
  </div>

  <p class="fineprint mono">A game, not a simulator: the speeds, sizes and scores are made up.</p>

  <section class="board" id="leaderboard" data-lr="board" aria-labelledby="lumen-run-board" hidden>
    <header class="board-head">
      <div>
        <p class="eyebrow">Leaderboard</p>
        <h2 id="lumen-run-board">Steadiest hands</h2>
      </div>
      <p class="board-meta mono" data-lr="board-meta"></p>
    </header>
    <ol class="board-rows" data-lr="board-rows"></ol>
    <ul class="board-you" data-lr="board-you" aria-label="Your position" hidden></ul>
    <p class="board-note mono" data-lr="board-note" role="status"></p>
    <template data-lr="board-row">
      <li class="board-row">
        <span class="pos"></span>
        <span class="who"></span>
        <span class="pts"></span>
      </li>
    </template>
  </section>
</div>

<script>
  import { mountLumenRun } from '../game/mount.ts';

  document.querySelectorAll<HTMLElement>('[data-lumen-run]').forEach(mountLumenRun);
</script>

<style>
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: calc(100svh - var(--header-h) - 2.5rem);
    min-height: 320px;
    background: var(--blue-950);
    border: 1px solid var(--line-dark);
    color: var(--on-dark);
    outline: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* While a run is on, the burr is the cursor and a finger steers instead of scrolling. */
  .stage[data-mode='playing'] {
    cursor: none;
    touch-action: none;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  /* ---- HUD ---- */

  .hud {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: 0 1rem;
    padding: clamp(0.7rem, 2vw, 1.15rem) clamp(0.8rem, 2.2vw, 1.4rem);
    font-family: var(--font-mono);
    pointer-events: none;
    text-shadow: 0 1px 6px rgba(0, 16, 31, 0.9);
    transition: opacity 0.3s;
  }

  .stage[data-mode='demo'] .hud {
    opacity: 0;
  }

  .k {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .hud-score .v {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hud-score b {
    font-size: clamp(1.25rem, 3vw, 1.9rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .multiplier {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    color: var(--on-dark-muted);
    text-shadow: none;
  }

  .multiplier.is-up {
    border-color: var(--maize);
    background: var(--maize);
    color: var(--blue-900);
  }

  .multiplier.is-pop {
    animation: pop 0.45s var(--ease);
  }

  @keyframes pop {
    30% {
      transform: scale(1.5);
    }
  }

  .hud-heat {
    --heat: 0;
    width: clamp(7rem, 24vw, 15rem);
    text-align: center;
  }

  .bar {
    display: block;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #ffcb05, #ff8a1f 60%, #ff4030);
    clip-path: inset(0 calc((1 - var(--heat)) * 100%) 0 0);
  }

  .hud-heat.is-hot .k {
    color: #ff6a5c;
    animation: warn 0.5s steps(2) infinite;
  }

  @keyframes warn {
    50% {
      opacity: 0.35;
    }
  }

  .hud-vessel {
    justify-self: end;
    /* Leave room for the pause button in the corner. */
    margin-right: 2.9rem;
    text-align: right;
  }

  .pips {
    display: inline-flex;
    gap: 0.3rem;
  }

  .pips i {
    width: 1.05rem;
    height: 8px;
    border: 1.5px solid #ff7a6b;
    border-radius: 999px;
    background: #ff7a6b;
    transition:
      background 0.25s,
      opacity 0.25s;
  }

  .pips i.is-lost {
    background: transparent;
    opacity: 0.45;
  }

  .hud-distance {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--on-dark-muted);
  }

  .hud-distance b {
    font-weight: 600;
    color: var(--on-dark);
    font-variant-numeric: tabular-nums;
  }

  /* Bottom right: the leaderboard score the player is closing in on. */
  .hud-chase {
    grid-column: 3;
    grid-row: 2;
    align-self: end;
    justify-self: end;
    text-align: right;
  }

  .hud-chase .k {
    margin-bottom: 0.2rem;
  }

  .chase-line {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--on-dark);
  }

  .chase-line b {
    max-width: 14ch;
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chase-line span {
    color: var(--maize);
    font-variant-numeric: tabular-nums;
  }

  .pause {
    position: absolute;
    top: clamp(0.6rem, 1.8vw, 1rem);
    right: clamp(0.7rem, 2vw, 1.2rem);
    display: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line-dark);
    border-radius: 50%;
    background: rgba(0, 16, 31, 0.55);
    color: var(--on-dark);
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .stage[data-mode='playing'] .pause {
    display: grid;
  }

  .pause:hover {
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.1);
  }

  /* ---- Segment banner ---- */

  .banner {
    position: absolute;
    top: 21%;
    left: 50%;
    display: grid;
    gap: 0.3rem;
    justify-items: center;
    width: max-content;
    max-width: 90%;
    font-family: var(--font-mono);
    text-transform: uppercase;
    text-align: center;
    text-shadow: 0 1px 8px rgba(0, 16, 31, 0.95);
    opacity: 0;
    translate: -50% 0;
    pointer-events: none;
  }

  .banner b {
    font-size: clamp(0.95rem, 2.4vw, 1.3rem);
    letter-spacing: 0.3em;
    color: var(--maize);
  }

  .banner span {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--on-dark);
  }

  .stage[data-mode='playing'] .banner.is-on {
    animation: banner 2.6s var(--ease) both;
  }

  @keyframes banner {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    15%,
    75% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  /* ---- Cards ---- */

  .panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: safe center;
    padding: 1rem;
    background: radial-gradient(ellipse at center, rgba(0, 16, 31, 0.78), rgba(0, 16, 31, 0.5));
    backdrop-filter: blur(1.5px);
    -webkit-backdrop-filter: blur(1.5px);
    text-align: center;
    overflow-y: auto;
    animation: panel-in 0.4s var(--ease) both;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
    }
  }

  .panel-body {
    display: grid;
    justify-items: center;
    width: min(100%, 46rem);
  }

  /* The start screen: the title on the left and, when there is room, the top scores beside it. */
  .start {
    display: flex;
    align-items: center;
    justify-content: safe center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .start .panel-body {
    flex: 0 1 36rem;
  }

  .top {
    flex: 0 0 17.5rem;
    padding: 1.2rem 1.3rem 1.1rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    background: rgba(0, 16, 31, 0.6);
    text-align: left;
  }

  .top-label {
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--maize);
  }

  .top h3 {
    margin: 0.35rem 0 0.8rem;
    font-size: 1.35rem;
    color: #fff;
  }

  .top-rows .board-row {
    grid-template-columns: 1.6rem 1fr auto;
    gap: 0.6rem;
    padding: 0.5rem 0.15rem;
    font-size: 0.9rem;
  }

  .top-rows .board-row .pts {
    font-size: 0.82rem;
  }

  .top-note {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--on-dark-muted);
  }

  .top-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
    transition: color 0.2s;
  }

  .top-more:hover {
    color: var(--maize);
  }

  /* On narrower screens the leaderboard below the game is already in view. */
  @media (max-width: 899px) {
    .top {
      display: none;
    }
  }

  .title {
    margin-top: 0.7rem;
    font-size: clamp(2.5rem, 8.5vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: #fff;
  }

  .title em {
    font-style: normal;
    color: var(--maize);
  }

  .title-small {
    margin-bottom: 1.6rem;
    font-size: clamp(1.8rem, 5vw, 3rem);
  }

  .pitch {
    text-wrap: balance;
    margin-top: 0.9rem;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--on-dark);
  }

  .rules {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.4rem;
    margin: 1.3rem 0 1.6rem;
    font-size: 0.85rem;
    color: var(--on-dark-muted);
  }

  .rules li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .swatch {
    flex: none;
    width: 1.1rem;
    height: 0.6rem;
    border-radius: 999px;
  }

  .swatch-plaque {
    border-radius: 0.5rem 0.5rem 0.15rem 0.15rem;
    background: #e9dfc9;
  }

  .swatch-wall {
    height: 4px;
    background: #ff7a6b;
  }

  .swatch-heat {
    height: 6px;
    background: linear-gradient(90deg, #ffcb05, #ff8a1f 60%, #ff4030);
  }

  .noscript {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--maize);
  }

  .hint {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem 1.2rem;
    margin-top: 1.2rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .best b {
    color: var(--maize);
  }

  .for-touch {
    display: none;
  }

  @media (hover: none) {
    .for-mouse {
      display: none;
    }

    .for-touch {
      display: inline;
    }
  }

  .final {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 0.9rem;
    margin-top: 0.6rem;
  }

  .final b {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8vw, 4.6rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .new-best {
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: var(--maize);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--blue-900);
  }

  .rank {
    margin-top: 0.5rem;
    color: var(--on-dark-muted);
  }

  .rank b {
    margin-left: 0.3rem;
    font-weight: 600;
    color: var(--maize);
  }

  .would {
    margin-top: 0.55rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--maize) 55%, transparent);
    border-radius: 999px;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--maize);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 0.8rem clamp(1rem, 3vw, 2rem);
    margin: 1.3rem 0 1.6rem;
    padding: 0.9rem 0;
    border-block: 1px solid var(--line-dark);
  }

  .stats dt {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .stats dd {
    margin: 0.25rem 0 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
  }

  .research {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--on-dark-muted);
    transition: color 0.2s;
  }

  .research:hover {
    color: var(--maize);
  }

  /* ---- Posting a score ---- */

  .post {
    width: min(100%, 30rem);
  }

  .title-post {
    margin-bottom: 1.1rem;
    font-size: clamp(1.5rem, 4vw, 2.3rem);
    line-height: 1.05;
  }

  .title-post span {
    color: var(--maize);
    font-variant-numeric: tabular-nums;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    width: 100%;
    text-align: left;
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  .field span {
    font-size: 0.64rem;
    letter-spacing: 0.14em;
